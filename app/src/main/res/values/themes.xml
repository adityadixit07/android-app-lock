<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompat base: androidx.biometric shows an AppCompat AlertDialog for fingerprint on
        API 26–27, which crashes under a non-AppCompat theme. All UI is drawn by Compose.
    -->
    <style name="Theme.AppLock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Opaque, animation-free host for BiometricPrompt over a locked app. -->
    <style name="Theme.AppLock.Biometric">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
