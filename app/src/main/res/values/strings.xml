    <!-- Onboarding -->
    <string name="welcome_title">Protect your private apps</string>
    <string name="welcome_body">Lock chats, photos, banking and anything else behind a PIN, pattern or your fingerprint.</string>
    <string name="welcome_point_no_ads">No ads, no trackers</string>
    <string name="welcome_point_no_ads_body">Free and open source, forever. Nothing to upsell.</string>
    <string name="welcome_point_offline">Works fully offline</string>
    <string name="welcome_point_offline_body">No internet permission, so your data never leaves this phone.</string>
    <string name="welcome_point_private">Never reads your screen</string>
    <string name="welcome_point_private_body">App Lock only knows which app opened, never what is inside it.</string>

    <!-- Permissions -->
    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro">App Lock needs a few special permissions to notice when a locked app opens and cover it. Each one is explained below and can be revoked at any time.</string>
    <string name="permissions_section_detection">Detect locked apps (choose one)</string>
    <string name="permissions_section_display">Show the lock screen</string>
    <string name="permissions_section_reliability">Stay reliable</string>
    <string name="permissions_section_biometric">Biometric unlock</string>
    <string name="badge_recommended">Recommended</string>
    <string name="badge_alternative">Alternative</string>
    <string name="perm_accessibility_title">Accessibility service</string>
    <string name="perm_accessibility_description">Instantly notices when an app opens, with no battery drain. App Lock only sees the app\'s name, never the contents of your screen.</string>
    <string name="perm_restricted_settings_hint">Switch greyed out? On Android 13+ open App info, tap ⋮ and choose “Allow restricted settings”, then try again.</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_description">Checks the foreground app a few times per second while the screen is on. Use this if you prefer not to enable Accessibility. Requires “Display over other apps”.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_description">Lets App Lock draw the lock screen on top of the app you\'re opening. Required for Usage access mode.</string>
    <string name="perm_battery_title">Unrestricted battery</string>
    <string name="perm_battery_description">Stops Android or your phone maker\'s battery saver from closing App Lock in the background.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_description">Shows a silent “protection active” notification in Usage access mode, so Android keeps the service running.</string>
    <string name="perm_biometric_title">Fingerprint or face</string>
