    <!-- Services -->
    <string name="accessibility_service_label">App Lock</string>
    <string name="accessibility_service_description">Detects when an app you have locked comes to the foreground so App Lock can ask for your PIN. It cannot read screen content, typed text or notifications.</string>
    <string name="notification_channel_protection">App protection</string>
    <string name="notification_channel_protection_description">Silent status shown while App Lock watches for locked apps</string>
    <string name="notification_protection_title">App Lock is active</string>
    <string name="notification_protection_text">Your locked apps are protected</string>

    <!-- Device admin -->
    <string name="device_admin_label">App Lock uninstall protection</string>
    <string name="device_admin_description">Prevents App Lock from being uninstalled without first deactivating this admin.</string>
    <string name="device_admin_explanation">App Lock uses no device admin powers. Activating it only stops the app from being uninstalled until you deactivate it here.</string>
    <string name="device_admin_disable_warning">Your locked apps will be easier to bypass once uninstall protection is off.</string>
